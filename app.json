{
  "expo": {
    "name": "CEQ",
    "slug": "ceq-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceqinformatica.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear la app y mostrar tu carnet."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ceqinformatica.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear la app y mostrar tu carnet."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#173874",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para leer el QR de los carnets de socio del CEQ.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "ceqapp",
    "experiments": {
      "typedRoutes": false
    },
    "primaryColor": "#173874",
    "owner": "ceq-una",
    "extra": {
      "eas": {
        "projectId": "6ae14514-4160-4347-a495-b2bf88094bc1"
      }
    }
  }
}
